{
  "name": "tech-lead-curriculum-api",
  "version": "1.0.0",
  "private": true,
  "description": "Accounts and shared progress for the tech-lead study plan (Cloudflare Worker + D1).",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply tech-lead-curriculum --local",
    "migrate:remote": "wrangler d1 migrations apply tech-lead-curriculum --remote",
    "db:seed:local": "wrangler d1 execute tech-lead-curriculum --local --file=./scripts/seed-dev.sql",
    "dev:token": "node scripts/dev-token.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "typescript": "7.0.2",
    "wrangler": "4.155.0"
  }
}

